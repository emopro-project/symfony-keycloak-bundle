{
  "name": "keycloak-auth/symfony-bundle",
  "type": "symfony-bundle",
  "license": "MIT",
  "description": "Modern Symfony bundle for Keycloak JWT authentication",
  "minimum-stability": "stable",
  "prefer-stable": true,

  "require": {
    "php": ">=8.1",
    "firebase/php-jwt": "^6.11",
    "symfony/security-bundle": "^6.4 || ^7.0",
    "symfony/http-client": "^6.4 || ^7.0",
    "symfony/framework-bundle": "^6.4 || ^7.0"
  },

  "require-dev": {
    "phpunit/phpunit": "^10 || ^11",
    "symfony/phpunit-bridge": "^6.4 || ^7.0"
  },

  "autoload": {
    "psr-4": {
      "Vendor\\SymfonyKeycloakBundle\\": "src/"
    }
  },

  "autoload-dev": {
    "psr-4": {
      "Vendor\\SymfonyKeycloakBundle\\Tests\\": "tests/"
    }
  },

  "conflict": {
    "symfony/symfony": "*"
  },

  "extra": {
    "branch-alias": {
      "dev-main": "1.0-dev"
    }
  }
}
